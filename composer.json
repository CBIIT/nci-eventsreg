{
    "name": "drupal-composer/drupal-project",
    "description": "Project template for Drupal 8 projects with composer",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "",
            "role": ""
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^1.2",
        "cweagans/composer-patches": "^1.7",
        "dompdf/dompdf": "^2.0.0",
        "drupal/add_to_head": "^1.0@beta",
        "drupal/admin_toolbar": "^3.5",
        "drupal/asset_injector": "^2.2",
        "drupal/autologout": "^2",
        "drupal/backup_migrate": "5.0.3",
        "drupal/bootstrap": "^5",
        "drupal/cache_control_override": "^2.0",
        "drupal/calendar_links_token": "^1.0@alpha",
        "drupal/captcha": "^2",
        "drupal/content_sync": "^4.0@RC",
        "drupal/core-composer-scaffold": "10.3",
        "drupal/core-project-message": "10.3",
        "drupal/core-recommended": "10.3",
        "drupal/csv_serialization": "4.0.1",
        "drupal/default_content": "^2",
        "drupal/default_content_deploy": "^2",
        "drupal/doc_serialization": "^4.0@beta",
        "drupal/entity": "^1.5",
        "drupal/entity_print": "^2.7",
        "drupal/externalauth": "^2.0",
        "drupal/extlink": "^2",
        "drupal/flood_control": "^2.2",
        "drupal/fontawesome": "^2.26",
        "drupal/gdoc_field": "^1.3",
        "drupal/google_analytics": "^4",
        "drupal/group": "^1.6",
        "drupal/hal": "^2",
        "drupal/honeypot": "^2.2",
        "drupal/imce": "^3.1",
        "drupal/jquery_ui_button": "^2.1",
        "drupal/jquery_ui_checkboxradio": "^2.1",
        "drupal/jquery_ui_draggable": "^2.1",
        "drupal/jquery_ui_resizable": "^2.1",
        "drupal/ldap": "^4.12",
        "drupal/mailsystem": "^4.1",
        "drupal/message_banner": "^2.0",
        "drupal/metatag": "^2",
        "drupal/module_missing_message_fixer": "^2.0",
        "drupal/nodeaccess": "^2.0@alpha",
        "drupal/pathauto": "^1.8",
        "drupal/pdf": "^1.2",
        "drupal/recaptcha": "^3.4",
        "drupal/redirect_after_login": "^2.3",
        "drupal/rules": "^4.0",
        "drupal/scheduler": "^1.4",
        "drupal/security_review": "^2.0",
        "drupal/select2": "^1.1",
        "drupal/smtp": "^1.4",
        "drupal/typed_data": "^2.0",
        "drupal/url_redirect": "^3.0",
        "drupal/views_data_export": "^1.2",
        "drupal/webform": "^6.2",
        "drupal/webform_views": "^5.0",
        "drush/drush": "^12.2",
        "phpoffice/phpword": "^0.18",
        "vlucas/phpdotenv": "^2.4",
        "webmozart/path-util": "^2.3"
    },   
    "conflict": {      
        "drupal/drupal": "*"
    },   
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true, 
        "allow-plugins": {                        
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true
        }                                   
    },                            
    "autoload": {                         
        "classmap": [                  
            "scripts/composer/ScriptHandler.php"
        ],                        
        "files": ["load.environment.php"]
    },                           
    "scripts": {                                      
        "drupal-scaffold": "DrupalComposer\\DrupalScaffold\\Plugin::scaffold",
        "pre-install-cmd": [   
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],                                      
        "pre-update-cmd": [                   
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],                                  
        "post-install-cmd": [          
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles"
        ],                                      
        "post-update-cmd": [    
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles",
            "drush updatedb -y",
            "drush cr"                 
        ]                             
    },                              
    "extra": {                          
        "patches": {         
            "drupal/redirect_after_login": {
            "Patch to fix login issue with redirect_after_login module": "https://www.drupal.org/files/issues/2022-07-26/redirect_after_login-3214949-107.patch"
            }                 
        },                                       
        "installer-paths": {   
            "web/core": ["type:drupal-core"],
            "web/libraries/{$name}": ["type:drupal-library"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/themes/{$name}": ["type:drupal-theme"],
            "drush/contrib/{$name}": ["type:drupal-drush"]
        }                                     
    }                              
}
