#/bin/bash
git clone https://github.com/cbiit/nci-eventsreg drupal11
cd drupal11
git checkout drupal11
cd ..
echo "running composer 10 install"
composer update

# Export config FIRST before anything is changed.
# This captures current block placements so we can restore them after upgrade.
echo "Exporting Drupal 10 config before upgrade..."
drush cex -y

drush ev "\Drupal::service('module_installer')->uninstall(['calendar_links_token','gdoc_field','doc_serialization']);"
drush cr
cp drupal11/composer.* ./
composer require drupal/group:^2.3 drupal/flexible_permissions:^2.0 -W
composer require drupal/variationcache:^1.5
rm -rf web/sites/default/files/php/*
rm -rf web/sites/default/files/css/*
rm -rf web/sites/default/files/js/*
drush updb -y
drush cr
composer update
drush ev "\Drupal::service('module_installer')->install(['jquery_ui','jquery_ui_draggable','jquery_ui_resizable']);"
rm -rf web/sites/default/files/php/*
drush updb -y

drush sqlq "TRUNCATE router"
drush sqlq "TRUNCATE sessions"
drush sqlq "TRUNCATE cache_bootstrap"
drush sqlq "TRUNCATE cache_config"
drush sqlq "TRUNCATE cache_container"
drush sqlq "TRUNCATE cache_data"
drush sqlq "TRUNCATE cache_default"
drush sqlq "TRUNCATE cache_discovery"
drush sqlq "TRUNCATE cache_dynamic_page_cache"
drush sqlq "TRUNCATE cache_entity"
drush sqlq "TRUNCATE cache_menu"
drush sqlq "TRUNCATE cache_page"
drush sqlq "TRUNCATE cache_render"
drush sqlq "TRUNCATE cache_toolbar"
rm -rf web/sites/default/files/php/*
drush cr
drush sqlq "DELETE FROM key_value_expire WHERE collection LIKE '%bootstrap%';"
drush sqlq "DELETE FROM key_value WHERE collection LIKE '%bootstrap%'"
rm -rf web/sites/default/files/php/*
drush cr
drush en
drush sqlq "DELETE FROM key_value_expire WHERE collection LIKE '%bootstrap%' OR name LIKE '%bootstrap%'"
drush sqlq "DELETE FROM key_value WHERE collection LIKE '%bootstrap%' OR name LIKE '%bootstrap%'"
rm -rf web/sites/default/files/php/*
drush cr
drush sqlq "DELETE FROM key_value_expire WHERE collection LIKE '%bootstrap%' OR collection LIKE '%cct%' OR name LIKE '%bootstrap%' OR name LIKE '%cct%'"
drush sqlq "DELETE FROM key_value WHERE collection LIKE '%bootstrap%' OR collection LIKE '%cct%' OR name LIKE '%bootstrap%' OR name LIKE '%cct%'"
rm -rf web/sites/default/files/php/*
drush cr

# ==============================================================================
# Restore block configuration
# Block configs are lost during the upgrade because updb rewrites config.
# We restore them from config/sync which was exported from the clean D10
# database at the top of this script.
# ==============================================================================
echo "Restoring block configuration..."

cat > /tmp/restore_blocks.php << 'PHPEOF'
<?php
$config_path = '/local/drupal/nci-cct-eventsreg/config/sync';
$files = glob($config_path . '/block.block.*.yml');
if (empty($files)) {
  print('ERROR: No block config files found in ' . $config_path . PHP_EOL);
  exit(1);
}
$config_factory = \Drupal::configFactory();
$count = 0;
foreach ($files as $file) {
  $name = basename($file, '.yml');
  $data = \Symfony\Component\Yaml\Yaml::parse(file_get_contents($file));
  $config_factory->getEditable($name)->setData($data)->save();
  $count++;
}
print('Restored ' . $count . ' block configs' . PHP_EOL);
PHPEOF

vendor/bin/drush php:script /tmp/restore_blocks.php
vendor/bin/drush cr
echo "Block config restored"

# ==============================================================================
# Groups 2.x permission migration fix
# Groups 2.x changed the permission format and several content type permissions
# are not migrated automatically. This block restores them, creates admin bypass
# roles, and adds uid 1 as a member of all groups.
#
# Root causes fixed here:
# 1. organization-member lost event + webform permissions in migration
# 2. data_form-member lost all permissions in migration
# 3. posters-member lost all permissions in migration
# 4. Groups 2.x query alter hides nodes from non-members (uid1 no longer bypasses)
# ==============================================================================
echo "Fixing Groups 2.x permission migration..."

cat > /tmp/fix_groups_upgrade.php << 'PHPEOF'
<?php

$role_storage = \Drupal::entityTypeManager()->getStorage('group_role');

// ------------------------------------------------------------------------------
// organization-member: restore missing event and webform permissions
// ------------------------------------------------------------------------------
$role = $role_storage->load('organization-member');
if ($role) {
  $existing = $role->getPermissions();
  $add = [
    'view group_node:event content',
    'view group_node:event entity',
    'view unpublished group_node:event entity',
    'create group_node:event content',
    'create group_node:event entity',
    'update any group_node:event content',
    'update any group_node:event entity',
    'update own group_node:event content',
    'update own group_node:event entity',
    'delete any group_node:event content',
    'delete any group_node:event entity',
    'delete own group_node:event content',
    'delete own group_node:event entity',
    'view group_node:webform content',
    'view group_node:webform entity',
    'view unpublished group_node:webform entity',
    'create group_node:webform content',
    'create group_node:webform entity',
    'update any group_node:webform content',
    'update any group_node:webform entity',
    'update own group_node:webform content',
    'update own group_node:webform entity',
    'delete any group_node:webform content',
    'delete any group_node:webform entity',
    'delete own group_node:webform content',
    'delete own group_node:webform entity',
  ];
  $role->set('permissions', array_unique(array_merge($existing, $add)));
  $role->save();
  print('organization-member: permissions restored' . PHP_EOL);
}

// ------------------------------------------------------------------------------
// data_form-member: restore all permissions (completely empty after migration)
// ------------------------------------------------------------------------------
$role = $role_storage->load('data_form-member');
if ($role) {
  $role->set('permissions', [
    'view group',
    'view group_membership content',
    'access group_node overview',
    'view group_node:webform content',
    'view group_node:webform entity',
    'view unpublished group_node:webform entity',
    'create group_node:webform content',
    'create group_node:webform entity',
    'update any group_node:webform content',
    'update any group_node:webform entity',
    'update own group_node:webform content',
    'update own group_node:webform entity',
    'delete any group_node:webform content',
    'delete any group_node:webform entity',
    'delete own group_node:webform content',
    'delete own group_node:webform entity',
  ]);
  $role->save();
  print('data_form-member: permissions restored' . PHP_EOL);
}

// ------------------------------------------------------------------------------
// posters-member: restore page and webform permissions
// ------------------------------------------------------------------------------
$role = $role_storage->load('posters-member');
if ($role) {
  $add = [
    'view group',
    'view group_membership content',
    'access group_node overview',
    'view group_node:page content',
    'view group_node:page entity',
    'view unpublished group_node:page entity',
    'create group_node:page content',
    'create group_node:page entity',
    'update any group_node:page content',
    'update any group_node:page entity',
    'update own group_node:page content',
    'update own group_node:page entity',
    'delete any group_node:page content',
    'delete any group_node:page entity',
    'delete own group_node:page content',
    'delete own group_node:page entity',
    'view group_node:webform content',
    'view group_node:webform entity',
    'view unpublished group_node:webform entity',
    'create group_node:webform content',
    'create group_node:webform entity',
    'update any group_node:webform content',
    'update any group_node:webform entity',
    'update own group_node:webform content',
    'update own group_node:webform entity',
    'delete any group_node:webform content',
    'delete any group_node:webform entity',
    'delete own group_node:webform content',
    'delete own group_node:webform entity',
  ];
  $role->set('permissions', array_unique(array_merge($role->getPermissions(), $add)));
  $role->save();
  print('posters-member: permissions restored' . PHP_EOL);
}

// ------------------------------------------------------------------------------
// Create admin bypass roles for each group type.
// Groups 2.x removed the automatic uid1 group access bypass from 1.x.
// A role with admin:TRUE bypasses all group permission checks for its members.
// ------------------------------------------------------------------------------
$admin_roles = [
  'organization-admin' => ['label' => 'Admin', 'group_type' => 'organization'],
  'data_form-admin'    => ['label' => 'Admin', 'group_type' => 'data_form'],
  'posters-admin'      => ['label' => 'Admin', 'group_type' => 'posters'],
];
foreach ($admin_roles as $role_id => $config) {
  if (!$role_storage->load($role_id)) {
    $role_storage->create([
      'id'          => $role_id,
      'label'       => $config['label'],
      'weight'      => 10,
      'admin'       => TRUE,
      'group_type'  => $config['group_type'],
      'scope'       => 'insider',
      'global_role' => 'administrator',
    ])->save();
    print($role_id . ': admin role created' . PHP_EOL);
  } else {
    print($role_id . ': admin role already exists, skipping' . PHP_EOL);
  }
}

// ------------------------------------------------------------------------------
// Add uid 1 as a plain member of every group it's not already in.
// Groups 2.x query alter hides grouped nodes from non-members — even uid 1.
// The insider admin roles above will automatically apply to uid 1 via
// global_role:administrator once they are a member.
// ------------------------------------------------------------------------------
$account = \Drupal\user\Entity\User::load(1);
$gids = \Drupal::entityQuery('group')->accessCheck(FALSE)->execute();
$groups = \Drupal\group\Entity\Group::loadMultiple($gids);
$added = 0;
foreach ($groups as $group) {
  if (!$group->getMember($account)) {
    $group->addMember($account);
    $added++;
  }
}
print('uid 1 added to ' . $added . ' groups' . PHP_EOL);
print('Done' . PHP_EOL);
PHPEOF

vendor/bin/drush php:script /tmp/fix_groups_upgrade.php
vendor/bin/drush cr
echo "Groups 2.x fixes complete"

